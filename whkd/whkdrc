.shell cmd

# cmd starts in ~0.1 s vs ~0.6 s for powershell, so every hotkey reacts faster.
# Only the few lines that need PowerShell call it explicitly. No trailing # comments on command lines (cmd would pass them on).

# Reload whkd configuration
alt + o                 : taskkill /f /im whkd.exe && start /b whkd
alt + shift + o         : komorebic reload-configuration

alt + i                 : komorebic toggle-shortcuts

# App shortcuts: focus the app if open, launch it if not
alt + return            : start "" "C:\Program Files\WezTerm\wezterm-gui.exe"
alt + b                 : pwsh -NoProfile -WindowStyle Hidden -Command "if (!(New-Object -ComObject WScript.Shell).AppActivate('Helium')) { Start-Process '{{HOME}}\scoop\shims\helium.exe' }"
alt + s                 : pwsh -NoProfile -WindowStyle Hidden -Command "if (!(New-Object -ComObject WScript.Shell).AppActivate('Slack')) { Start-Process '{{HOME}}\scoop\apps\slack\current\Slack.exe' }"
alt + e                 : start "" explorer.exe
alt + shift + escape    : start "" taskmgr.exe

alt + q                 : komorebic close
alt + m                 : komorebic minimize
alt + shift + b         : pwsh -NoProfile -WindowStyle Hidden -Command "Get-Process komorebi-bar -EA 0 | Stop-Process -Force; 0..2 | ForEach-Object { Start-Process komorebi-bar -ArgumentList '--config', ($env:USERPROFILE + '\komorebi.bar.monitor' + $_ + '.json') -WindowStyle Hidden }"

# Teach komorebi about the focused window: float it from now on / leave it alone from now on
alt + ctrl + t          : pwsh -NoProfile -WindowStyle Hidden -File "{{HOME}}\komorebi.learn.ps1" float
alt + ctrl + i          : pwsh -NoProfile -WindowStyle Hidden -File "{{HOME}}\komorebi.learn.ps1" ignore

# Focus windows
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right
# oem_4 is [ and oem_6 is ]
alt + shift + oem_4     : komorebic cycle-focus previous
alt + shift + oem_6     : komorebic cycle-focus next

# Move windows
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right
alt + shift + return    : komorebic promote

# Stack windows
alt + left              : komorebic stack left
alt + down              : komorebic stack down
alt + up                : komorebic stack up
alt + right             : komorebic stack right
# oem_1 is ;
alt + oem_1             : komorebic unstack
alt + oem_4             : komorebic cycle-stack previous
alt + oem_6             : komorebic cycle-stack next

# Resize
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
alt + t                 : komorebic toggle-float
alt + shift + t         : komorebic toggle-transparency
alt + shift + f         : komorebic toggle-monocle
alt + f                 : komorebic toggle-maximize

# Window manager options
alt + shift + r         : komorebic retile
alt + p                 : komorebic toggle-pause

# Layouts
alt + x                 : komorebic flip-layout horizontal
alt + y                 : komorebic flip-layout vertical

# Workspaces
alt + 1                 : komorebic focus-named-workspace 1
alt + 2                 : komorebic focus-named-workspace 2
alt + 3                 : komorebic focus-named-workspace 3
alt + 4                 : komorebic focus-named-workspace 4
alt + 5                 : komorebic focus-named-workspace 5
alt + 6                 : komorebic focus-named-workspace 6
alt + 7                 : komorebic focus-named-workspace 7
alt + 8                 : komorebic focus-named-workspace 8
alt + 9                 : komorebic focus-named-workspace 9

# Move windows across workspaces
alt + shift + 1         : komorebic move-to-named-workspace 1
alt + shift + 2         : komorebic move-to-named-workspace 2
alt + shift + 3         : komorebic move-to-named-workspace 3
alt + shift + 4         : komorebic move-to-named-workspace 4
alt + shift + 5         : komorebic move-to-named-workspace 5
alt + shift + 6         : komorebic move-to-named-workspace 6
alt + shift + 7         : komorebic move-to-named-workspace 7
alt + shift + 8         : komorebic move-to-named-workspace 8
alt + shift + 9         : komorebic move-to-named-workspace 9

# Monitors
alt + oem_comma         : komorebic cycle-monitor previous
alt + oem_period        : komorebic cycle-monitor next
alt + shift + oem_comma : komorebic cycle-move-to-monitor previous
alt + shift + oem_period : komorebic cycle-move-to-monitor next
alt + ctrl + oem_comma  : komorebic cycle-move-workspace-to-monitor previous
alt + ctrl + oem_period : komorebic cycle-move-workspace-to-monitor next
